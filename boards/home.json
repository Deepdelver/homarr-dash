    "custom_css": "/*\n * Buddy Hub inspired Homarr theme\n * ----------------------------------------------------------------------------\n * Goal: make the deeps-home Homarr dashboard match the clean aesthetic of\n *       https://buddy.deeps-home.duckdns.org\n *   - Light, airy background (#f5f5f7) like Buddy Hub\n *   - Rounded cards (12-16px) with subtle shadows\n *   - Generous spacing between widgets\n *   - Clean Inter typography\n *   - Calm blue accent (#3b82f6) instead of Homarr's default red\n *   - Responsive mobile grid (no more \"disgusting\" phone view)\n *   - Gentle hover lift on every widget\n *\n * Applied via Homarr Settings -> Appearance -> Custom CSS, or (preferred, for\n * GitOps) by the apply script in .github/workflows which pushes this exact\n * string into board.custom_css through board.saveBoard.\n *\n * Homarr v1.32 is Mantine-based; widgets render as .mantine-Paper-root inside a\n * CSS grid. Selectors below are defensive (attribute/class contains + base\n * Mantine classes) so the theme survives minor Homarr point releases.\n */\n\n:root {\n  /* Buddy Hub palette */\n  --bh-bg: #f5f5f7;\n  --bh-card: #ffffff;\n  --bh-card-soft: #fafafa;\n  --bh-border: rgba(17, 24, 39, 0.06);\n  --bh-shadow: 0 1px 3px rgba(17, 24, 39, 0.08), 0 1px 2px rgba(17, 24, 39, 0.04);\n  --bh-shadow-hover: 0 6px 16px rgba(17, 24, 39, 0.12), 0 2px 4px rgba(17, 24, 39, 0.06);\n  --bh-text: #1f2937;\n  --bh-text-muted: #6b7280;\n  --bh-accent: #3b82f6;\n  --bh-accent-soft: #eff6ff;\n  --bh-radius: 14px;\n\n  /* Re-tint Homarr's Mantine accent tokens to Buddy Hub blue */\n  --mantine-primary-color-filled: var(--bh-accent);\n  --mantine-primary-color-filled-hover: #2f74e0;\n  --mantine-primary-color-light: var(--bh-accent-soft);\n  --mantine-primary-color-light-color: var(--bh-accent);\n  --mantine-color-bundle-default: #3b82f6;\n}\n\n/* ---- Global canvas ---- */\nhtml,\nbody,\n#root,\n[data-mantine-color-scheme],\n.mantine-AppShell-root,\n.mantine-AppShell-main {\n  background-color: var(--bh-bg) !important;\n  color: var(--bh-text);\n  font-family: \"Inter\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif !important;\n  -webkit-font-smoothing: antialiased;\n  text-rendering: optimizeLegibility;\n}\n\n/* ---- Top app bar: lighten + tighten ---- */\n.mantine-AppShell-header,\n[data-position=\"top\"] {\n  background-color: rgba(255, 255, 255, 0.85) !important;\n  backdrop-filter: saturate(180%) blur(8px);\n  border-bottom: 1px solid var(--bh-border) !important;\n}\n\n/* ---- Widget cards ---- */\n.mantine-Paper-root,\n[class*=\"WidgetWrapper\"],\n[class*=\"widget\"] {\n  background-color: var(--bh-card) !important;\n  border: 1px solid var(--bh-border) !important;\n  border-radius: var(--bh-radius) !important;\n  box-shadow: var(--bh-shadow) !important;\n  transition: box-shadow 160ms ease, transform 160ms ease, border-color 160ms ease;\n  overflow: hidden;\n}\n\n/* Hover lift (skip while dragging/editing) */\n.mantine-Paper-root:hover,\n[class*=\"WidgetWrapper\"]:hover {\n  box-shadow: var(--bh-shadow-hover) !important;\n  transform: translateY(-2px);\n  border-color: rgba(59, 130, 246, 0.25) !important;\n}\n\n/* Soften inner dividers / borders inside widgets for a cleaner look */\n[class*=\"WidgetWrapper\"] [class*=\"Divider\"],\n.mantine-Divider-root {\n  border-color: var(--bh-border) !important;\n}\n\n/* ---- Headings & labels inside widgets ---- */\n[class*=\"WidgetWrapper\"] h1,\n[class*=\"WidgetWrapper\"] h2,\n[class*=\"WidgetWrapper\"] h3,\n[class*=\"WidgetWrapper\"] [class*=\"Title\"],\n[class*=\"WidgetWrapper\"] [class*=\"title\"] {\n  color: var(--bh-text) !important;\n  font-weight: 700 !important;\n  letter-spacing: -0.01em;\n}\n\n[class*=\"WidgetWrapper\"] [class*=\"Text\"],\n[class*=\"WidgetWrapper\"] [class*=\"text\"],\n[class*=\"WidgetWrapper\"] span {\n  color: var(--bh-text) !important;\n}\n\n[class*=\"WidgetWrapper\"] [class*=\"TextMuted\"],\n[class*=\"WidgetWrapper\"] [class*=\"muted\"] {\n  color: var(--bh-text-muted) !important;\n}\n\n/* ---- Board grid spacing (more breathing room) ---- */\n.mantine-Grid-root,\n[class*=\"masonry\"] > *,\n[class*=\"Grid\"] {\n  gap: 16px !important;\n}\n\n/* Per-cell spacing fallback for older grid layouts */\n.mantine-Grid-col {\n  padding: 8px !important;\n}\n\n/* ---- Cleaner buttons & inputs ---- */\n.mantine-Button-root {\n  border-radius: 10px !important;\n  font-weight: 600 !important;\n}\n\n.mantine-TextInput-input,\n.mantine-Select-input,\n.mantine-Input-input {\n  border-radius: 10px !important;\n}\n\n/* ---- Links & accents ---- */\na,\n[class*=\"Anchor\"] {\n  color: var(--bh-accent) !important;\n}\n\n/* Status dots / indicators read better with the calm accent */\n[class*=\"indicator\"],\n[class*=\"status\"] {\n  color: var(--bh-accent) !important;\n}\n\n/* =====================================================================\n * DARK MODE \u2014 keep the same clean language, just darker surfaces\n * ===================================================================== */\n[data-mantine-color-scheme=\"dark\"],\n[data-mantine-color-scheme=\"dark\"] .mantine-AppShell-main {\n  --bh-bg: #16181d;\n  --bh-card: #1e2128;\n  --bh-card-soft: #20242c;\n  --bh-border: rgba(255, 255, 255, 0.07);\n  --bh-shadow: 0 1px 3px rgba(0, 0, 0, 0.4);\n  --bh-shadow-hover: 0 6px 16px rgba(0, 0, 0, 0.5);\n  --bh-text: #e5e7eb;\n  --bh-text-muted: #9ca3af;\n  --bh-accent-soft: rgba(59, 130, 246, 0.15);\n}\n\n[data-mantine-color-scheme=\"dark\"] .mantine-AppShell-header {\n  background-color: rgba(22, 24, 29, 0.85) !important;\n}\n\n/* =====================================================================\n * MOBILE  (phone viewport \u2014 previously \"disgusting\")\n * Stack widgets to a comfortable 1-2 column rhythm with sane gaps.\n * ===================================================================== */\n@media (max-width: 768px) {\n  :root {\n    --bh-radius: 12px;\n  }\n\n  .mantine-AppShell-main {\n    padding: 12px !important;\n  }\n\n  /* Homarr collapses the grid on small screens; ensure full-width tiles\n     with consistent vertical rhythm and no clipping. */\n  .mantine-Grid-col,\n  [class*=\"Grid-col\"] {\n    flex-basis: 100% !important;\n    max-width: 100% !important;\n    padding: 6px !important;\n  }\n\n  .mantine-Grid-root,\n  [class*=\"masonry\"] > * {\n    gap: 12px !important;\n  }\n\n  .mantine-Paper-root,\n  [class*=\"WidgetWrapper\"] {\n    border-radius: 12px !important;\n  }\n\n  /* Don't lift on touch \u2014 avoids janky scroll */\n  .mantine-Paper-root:hover,\n  [class*=\"WidgetWrapper\"]:hover {\n    transform: none;\n  }\n\n  /* Shrink the header so content gets the screen */\n  .mantine-AppShell-header {\n    padding-left: 12px !important;\n    padding-right: 12px !important;\n  }\n}\n\n@media (min-width: 769px) and (max-width: 1024px) {\n  .mantine-Grid-col,\n  [class*=\"Grid-col\"] {\n    flex-basis: 50% !important;\n    max-width: 50% !important;\n  }\n}",
